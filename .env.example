# ───────────────────────────────────────────────────────────────────────────
# SubWise — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser; everything
# else is server-only and must never be referenced from client components.
# ───────────────────────────────────────────────────────────────────────────

# App ─────────────────────────────────────────────────────────────────────────
# Base URL of the app. Used for magic-link redirects and Stripe success/cancel
# URLs. Use http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase ────────────────────────────────────────────────────────────────────
# Create a project at https://app.supabase.com, then: Project Settings → API.
# Project URL + anon (public) key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is SECRET (server-only). Used by the Stripe webhook to flip a
# user's plan tier with elevated privileges. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic ───────────────────────────────────────────────────────────────────
# https://console.anthropic.com → API Keys. Server-only. Powers smart-paste
# parsing and the AI insights panel (model: claude-sonnet-4-6).
ANTHROPIC_API_KEY=

# Stripe — TEST MODE ──────────────────────────────────────────────────────────
# https://dashboard.stripe.com (toggle "Test mode") → Developers → API keys.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...) — safe for the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Recurring Price ID for the Pro plan (price_...). Create a Product + recurring
# Price in the Stripe dashboard and paste its ID here.
STRIPE_PRO_PRICE_ID=
# Webhook signing secret (whsec_...). From `stripe listen --forward-to
# localhost:3000/api/stripe/webhook` locally, or the endpoint settings in prod.
STRIPE_WEBHOOK_SECRET=
